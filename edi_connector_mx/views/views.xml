<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_edi_document_list" model="ir.ui.view">
        <field name="name">x_edi_document.list</field>
        <field name="model">x_edi_document</field>
        <field name="arch" type="xml">
            <list create="false" default_order="x_date desc"
                  decoration-danger="x_state in ('error', 'rejected')" decoration-success="x_state in ('done', 'accepted')"
                  decoration-info="x_state in ('received', 'sent')">
                <field name="x_date"/>
                <field name="x_doc_type"/>
                <field name="x_direction"/>
                <field name="x_name"/>
                <field name="x_trading_partner"/>
                <field name="x_sale_order_id"/>
                <field name="x_invoice_id"/>
                <field name="x_state" widget="badge"/>
                <field name="x_pages" sum="Billable pages"/>
                <field name="x_message"/>
            </list>
        </field>
    </record>
    <record id="view_edi_document_form" model="ir.ui.view">
        <field name="name">x_edi_document.form</field>
        <field name="model">x_edi_document</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <header><field name="x_state" widget="statusbar"/></header>
                <sheet>
                    <h1><field name="x_name"/></h1>
                    <group>
                        <group>
                            <field name="x_doc_type"/>
                            <field name="x_direction"/>
                            <field name="x_trading_partner"/>
                            <field name="x_date"/>
                            <field name="x_pages"/>
                        </group>
                        <group>
                            <field name="x_sale_order_id"/>
                            <field name="x_invoice_id"/>
                        </group>
                    </group>
                    <field name="x_message"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_edi_document_search" model="ir.ui.view">
        <field name="name">x_edi_document.search</field>
        <field name="model">x_edi_document</field>
        <field name="arch" type="xml">
            <search>
                <field name="x_name"/>
                <field name="x_trading_partner"/>
                <filter name="errors" string="Errors" domain="[('x_state', 'in', ('error', 'rejected'))]"/>
                <filter name="received" string="Received" domain="[('x_direction', '=', 'in')]"/>
                <filter name="sent" string="Sent" domain="[('x_direction', '=', 'out')]"/>
                <group>
                    <filter name="by_type" string="Document" context="{'group_by': 'x_doc_type'}"/>
                    <filter name="by_state" string="Status" context="{'group_by': 'x_state'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="view_edi_connection_list" model="ir.ui.view">
        <field name="name">x_edi_connection.list</field>
        <field name="model">x_edi_connection</field>
        <field name="arch" type="xml">
            <list create="false" decoration-danger="x_state == 'error'" decoration-success="x_state == 'connected'">
                <field name="x_name"/>
                <field name="x_state" widget="badge"/>
                <field name="x_last_sync"/>
                <field name="x_message"/>
            </list>
        </field>
    </record>

    <record id="action_edi_document" model="ir.actions.act_window">
        <field name="name">EDI Documents</field>
        <field name="res_model">x_edi_document</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No EDI documents yet</p>
            <p>Documents exchanged with your retail customers appear here once your EDI provider is connected.</p>
        </field>
    </record>
    <record id="action_edi_connection" model="ir.actions.act_window">
        <field name="name">Connection</field>
        <field name="res_model">x_edi_connection</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Not connected</p>
            <p>Your EDI provider sets the connection status here when the service is activated.</p>
        </field>
    </record>

    <menuitem id="menu_edi_root" name="EDI" web_icon="edi_connector_mx,static/description/icon.png"
              groups="group_edi_user" sequence="45"/>
    <menuitem id="menu_edi_documents" name="Documents" parent="menu_edi_root" action="action_edi_document" sequence="10"/>
    <menuitem id="menu_edi_connection" name="Connection" parent="menu_edi_root" action="action_edi_connection" sequence="20"/>
</odoo>
